{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "serangkai",
  "compatibility_date": "2025-07-15",
  "main": "./.output/server/index.mjs",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NODE_ENV": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "serangkai-local",
      "database_id": "local-serangkai-d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "serangkai-artifacts"
    }
  ]
}
