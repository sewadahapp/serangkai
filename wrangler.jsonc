{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "serangkai",
  "compatibility_date": "2025-07-15",
  "main": "./.output/server/index.mjs",
  "compatibility_flags": ["nodejs_compat"],
  // Static client assets (JS, CSS, fonts, icons, artifact runtimes). Without
  // this block `wrangler deploy` uploads the Worker alone and every /_nuxt
  // request 404s. Nitro's own preset generates an equivalent binding, but this
  // checked-in file wins, so it has to declare it too.
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public"
  },
  "vars": {
    "NODE_ENV": "production"
  },
  // No account-specific ids or bucket names: Wrangler and the Deploy to
  // Cloudflare button provision both resources and bind them to the Worker.
  // Manual deployments can add the ids returned by `wrangler d1 create` and
  // `wrangler r2 bucket create` instead.
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS"
    }
  ]
}
