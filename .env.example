# Required for a production deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Two different, stable random secrets (32+ characters).
JWT_SECRET=replace-with-openssl-rand-base64-32
SHARE_SECRET=replace-with-a-different-openssl-rand-base64-32

# Optional overrides.
# DATABASE_PATH=./data/serangkai.db
# STORAGE_PATH=./data/files
# STORAGE_DRIVER=local
# PUBLIC_BASE_URL=

# Only when upgrading a database that already contains multiple users.
# Pick one user id from the startup error message; other accounts keep their
# data but can no longer authenticate.
# SERANGKAI_MIGRATION_OWNER_USER_ID=

# Only for edge platforms whose entry point cannot run scripts/start.mjs.
# Derive with: bun scripts/derive-session-secret.mjs "$JWT_SECRET"
# NUXT_APP_SECRET=

# Test/development only; never set in production.
# SERANGKAI_ALLOW_EPHEMERAL_STORAGE=true
