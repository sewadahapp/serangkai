# Worker secrets. On Cloudflare, add each under the Worker's
# Settings → Variables and Secrets (type: Secret). For local `wrangler dev`,
# copy this file to .dev.vars. See docs/deploy-cloudflare.md.
# Generate each random value with: openssl rand -base64 32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
JWT_SECRET=replace-with-a-random-32-byte-secret
SHARE_SECRET=replace-with-a-different-random-32-byte-secret

# Workers cannot run scripts/start.mjs, so the session key must be supplied
# explicitly instead of being derived from JWT_SECRET. Keep it stable.
NUXT_APP_SECRET=replace-with-a-different-random-32-byte-secret

# Turso database (deploy:turso and deploy:turso-b2 only)
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# Backblaze B2 or other S3-compatible storage (deploy:b2 and deploy:turso-b2 only)
# S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# S3_REGION=us-west-004
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Optional: set this when serving the Worker from a custom domain.
# PUBLIC_BASE_URL=https://serangkai.example.com
