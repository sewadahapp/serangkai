# Secrets prompted by the Deploy to Cloudflare button.
# Generate each random value with: openssl rand -base64 32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
JWT_SECRET=replace-with-a-random-32-byte-secret
SHARE_SECRET=replace-with-a-different-random-32-byte-secret

# Workers cannot run scripts/start.mjs, so the session key must be supplied
# explicitly instead of being derived from JWT_SECRET. Keep it stable.
NUXT_APP_SECRET=replace-with-a-different-random-32-byte-secret

# Optional: set this when serving the Worker from a custom domain.
# PUBLIC_BASE_URL=https://serangkai.example.com
