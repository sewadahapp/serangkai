{
  "name": "serangkai",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "build:node": "NITRO_PRESET=node-server nuxt build",
    "build:cloudflare": "NITRO_PRESET=cloudflare_module nuxt build",
    "build:vercel": "NITRO_PRESET=vercel nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test:mcp": "npm run build && node --test tests/mcp-protocol.test.mjs",
    "test:upload": "npm run build && node --test tests/upload-api.test.mjs",
    "test:share": "npm run build && node --test tests/share-api.test.mjs",
    "test:tokens": "npm run build && node --test tests/tokens-api.test.mjs",
    "test:folders": "npm run build && node --test tests/folders-api.test.mjs",
    "test:lifecycle": "npm run build && node --test tests/artifacts-lifecycle.test.mjs",
    "test:security": "npm run build && node --test tests/security-api.test.mjs",
    "test:browser": "npm run build && node --test tests/browser-workspace.test.mjs",
    "test:markdown": "node --import tsx --test tests/markdown-render.test.mjs",
    "test:bundle": "npm run build && node --test tests/bundle-api.test.mjs",
    "test:deployment-config": "node --test tests/deployment-config.test.mjs",
    "test:deployment-files": "node --test tests/deployment-files.test.mjs",
    "test:release-readiness": "node --test tests/release-readiness.test.mjs",
    "test:ci-workflow": "node --test tests/ci-workflow.test.mjs",
    "test:storage": "node --import tsx --test tests/storage-adapter.test.mjs",
    "test:database": "node --import tsx --test tests/database-adapter.test.mjs",
    "test:local-runtime": "npm run build && node --test tests/local-runtime.test.mjs",
    "test:cloudflare-runtime": "npm run build:cloudflare && node --test tests/cloudflare-runtime.test.mjs",
    "test:r2": "node --import tsx --test tests/r2-storage.test.mjs",
    "test:r2-request": "node --import tsx --test tests/r2-request-runtime.test.mjs",
    "test:vercel-runtime": "NITRO_PRESET=node-server npm run build:node && node --test tests/vercel-runtime.test.mjs",
    "test:provider-local": "npm run test:database && npm run test:storage && npm run test:r2 && npm run test:r2-request && npm run test:local-runtime && npm run test:cloudflare-runtime && npm run test:vercel-runtime",
    "test:ci": "npm run build:node && npm run test:markdown && npm run test:deployment-config && npm run test:database && npm run test:storage && npm run test:r2 && npm run test:r2-request",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nuxt/content": "^3.16.2",
    "@sewadah/selaras": "^1.3.0",
    "@tanstack/vue-charts": "^1.2.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "marked": "^18.1.2",
    "mermaid": "^12.2.0",
    "nanoid": "^6.0.2",
    "nuxt": "^4.6.3",
    "sanitize-html": "^2.18.1",
    "unstorage": "^2.0.0-beta.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "wrangler": "^4.156.1"
  }
}
