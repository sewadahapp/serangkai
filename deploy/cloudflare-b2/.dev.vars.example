# Secrets prompted by the Deploy to Cloudflare button.
# Generate each random value with: openssl rand -base64 32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
JWT_SECRET=replace-with-a-random-32-byte-secret
SHARE_SECRET=replace-with-a-different-random-32-byte-secret
NUXT_APP_SECRET=replace-with-a-different-random-32-byte-secret

# Backblaze B2 (S3-compatible). Create a private bucket and a bucket-scoped
# application key first; see the repository README.
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_BUCKET=your-private-bucket
S3_ACCESS_KEY_ID=your-application-key-id
S3_SECRET_ACCESS_KEY=your-application-key