{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "serangkai",
  "compatibility_date": "2025-07-15",
  "main": "./.output/server/index.mjs",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public"
  },
  "vars": {
    "NODE_ENV": "production",
    "DATABASE_DRIVER": "turso",
    "STORAGE_DRIVER": "r2-binding"
  },
  // The button provisions R2 for files. Turso holds every database row;
  // there is deliberately no D1 binding or database to provision.
  "r2_buckets": [
    {
      "binding": "RANGKA"
    }
  ]
  // TURSO_DATABASE_URL and TURSO_AUTH_TOKEN are prompted as Worker secrets.
}
