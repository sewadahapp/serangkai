{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "serangkai",
  "compatibility_date": "2025-07-15",
  "main": "./.output/server/index.mjs",
  "compatibility_flags": ["nodejs_compat"],
  // Same asset binding as the default config; see wrangler.jsonc.
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public"
  },
  // Backblaze B2 replaces only object storage. D1 still holds every row.
  // No r2_buckets block: this path must not provision or require R2.
  "vars": {
    "NODE_ENV": "production",
    "STORAGE_DRIVER": "s3"
  },
  "d1_databases": [
    {
      "binding": "DB"
      // Manual deployments: create the database with `wrangler d1 create
      // serangkai` and paste the returned database_id here.
    }
  ]
  // S3_ENDPOINT, S3_REGION, S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY
  // are Worker secrets (`wrangler secret put`), never committed values.
}