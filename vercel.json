{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nuxtjs",
  "buildCommand": "bun run build:vercel",
  "installCommand": "bun install --frozen-lockfile --ignore-scripts",
  "outputDirectory": ".output",
  "functions": {
    "api/**/*.mjs": {
      "runtime": "nodejs24.x"
    }
  }
}
